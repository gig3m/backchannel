# Maintainer: Kyle Arrington <kyle@arrington.co>
pkgname=backchanneld
pkgver=0.1.0
pkgrel=1
pkgdesc="Slack session daemon for the Backchannel Omarchy plugin (built from source)"
arch=('x86_64' 'aarch64')
url="https://github.com/gig3m/backchannel"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
provides=('backchanneld')
conflicts=('backchanneld-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # filled in by scripts/release.sh

build() {
  cd "backchannel-$pkgver/daemon"
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w -X main.version=$pkgver" -o backchanneld ./cmd/backchanneld
}

check() {
  cd "backchannel-$pkgver/daemon"
  go test ./...
}

package() {
  cd "backchannel-$pkgver"
  install -Dm755 daemon/backchanneld "$pkgdir/usr/bin/backchanneld"
  install -Dm644 daemon/packaging/backchanneld.service "$pkgdir/usr/lib/systemd/user/backchanneld.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
